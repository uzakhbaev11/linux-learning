    "test:browser": "bash tests/run-browser-test.sh"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "marked": "15.0.12",
    "v86": "0.5.472"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
